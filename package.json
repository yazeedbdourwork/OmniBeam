{
  "name": "omnibeam",
  "version": "1.0.0",
  "description": "Send files, photos and text between any devices in the browser: an open-source, end-to-end encrypted AirDrop alternative for iPhone, Android, Windows, Mac and Linux (WebRTC)",
  "keywords": ["file-sharing", "file-transfer", "airdrop-alternative", "webrtc", "p2p", "end-to-end-encryption", "pwa", "self-hosted", "snapdrop-alternative", "pairdrop"],
  "homepage": "https://omnibeam.site",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test -c tests",
    "test:setup": "playwright install chromium",
    "deploy": "node tools/deploy.js",
    "deploy:check": "node tools/deploy.js --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.10.3"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/yazeedbdourwork/OmniBeam.git"
  }
}
