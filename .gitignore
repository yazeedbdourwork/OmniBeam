backup-*/
backup-*.zip
deploy/
/*.zip
public/index.zip

# Installed packages
node_modules/

# Secrets and signing keys: never commit them
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
